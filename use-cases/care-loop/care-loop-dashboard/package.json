{
  "name": "care-loop-dashboard",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "bun run db:migrate && bun --bun next dev",
    "build": "bun run db:migrate && bun --bun next build",
    "start": "bun run db:migrate && bun --bun next start -p 3003",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "bun run scripts/migrate.ts",
    "lint": "eslint",
    "lint:fix": "eslint --fix",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "typecheck": "tsc --noEmit",
    "knip": "knip"
  },
  "dependencies": {
    "@types/fhir": "^0.0.44",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.2",
    "fhir-kit-client": "^2.0.2",
    "lucide-react": "^1.21.0",
    "next": "16.2.9",
    "radix-ui": "^1.6.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^9.1.0",
    "@biomejs/biome": "^2.5.1",
    "@eslint-react/eslint-plugin": "^5.9.2",
    "@tailwindcss/postcss": "^4",
    "@types/bun": "^1.2.0",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9",
    "eslint-plugin-react-refresh": "^0.5.3",
    "knip": "^6.19.0",
    "shadcn": "^4.11.0",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "ignoreScripts": [
    "sharp",
    "unrs-resolver"
  ],
  "trustedDependencies": [
    "sharp",
    "unrs-resolver"
  ]
}
